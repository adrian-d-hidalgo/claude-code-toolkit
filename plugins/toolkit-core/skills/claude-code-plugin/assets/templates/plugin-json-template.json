{
  "name": "plugin-name",
  "description": "Brief description of what this plugin does and provides",
  "version": "1.0.0",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "homepage": "https://github.com/username/plugin-name",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/plugin-name"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "mcp",
    "your-domain",
    "your-technology"
  ],
  "license": "MIT",
  "engines": {
    "claude": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "commands": [
    "./commands/example-command.md"
  ],
  "agents": [
    "./agents/example-agent.md"
  ],
  "hooks": [
    "./hooks/hooks.json"
  ],
  "mcpServers": {
    "example-server": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${PWD}/data"
      ],
      "env": {
        "DEBUG": "${DEBUG:-false}"
      }
    },
    "custom-server": {
      "command": "${CLAUDE_PLUGIN_ROOT}/servers/custom/server.py",
      "args": [
        "--port",
        "8080"
      ],
      "env": {
        "API_KEY": "${API_KEY}",
        "DATABASE_URL": "${DATABASE_URL}",
        "PORT": "${PORT:-8080}",
        "LOG_LEVEL": "${LOG_LEVEL:-info}",
        "ENABLE_CACHE": "true"
      }
    }
  }
}
